# ============= TELEGRAM CONFIG =============
# Получите на https://my.telegram.org/apps
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Имя сессии (можно любое)
SESSION_NAME=tg_monitor

# Username канала для мониторинга (например: @channelname)
CHANNEL_USERNAME=@your_channel_username

# ============= DIRECTORIES =============
# Директория для скачанных файлов
DOWNLOAD_DIR=./downloads

# Директория для распакованных архивов
EXTRACT_DIR=./extracted

# Файл с результатами совпадений
OUTPUT_MATCHES_FILE=./matches.txt

# ============= PASSWORDS =============
# Файл с паролями для архивов (один пароль на строку)
PASSWORD_FILE=./passwords.txt

# Файл истории паролей (автоматически создается)
PASSWORD_HISTORY_FILE=./password_history.json

# ============= BOT NOTIFICATIONS =============
# Токен бота для уведомлений (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID админа для уведомлений (получите у @userinfobot)
ADMIN_CHAT_ID=123456789

# ============= KEYWORDS =============
# Файл с ключевыми словами (одно слово/фраза на строку)
KEYWORDS_FILE=./keywords.txt

# ============= PERFORMANCE =============
# Максимальное количество параллельных загрузок
MAX_PARALLEL_DOWNLOADS=4

# Количество воркеров для обработки файлов
NUM_WORKERS=4

# Размер данных для быстрого хеша (в МБ)
HASH_QUICK_BYTES_MB=16

# ============= FILE MANAGEMENT =============
# Удалять скачанные файлы после обработки (true/false)
CLEANUP_DOWNLOADS=false

# Удалять распакованные файлы после сканирования (true/false)
# ВАЖНО: false = файлы сохраняются (можно проверить вручную)
#        true = файлы удаляются сразу (экономия места)
CLEANUP_EXTRACTED=false

# ============= SECURITY =============
# Максимальный размер файла для скачивания (в МБ)
MAX_FILE_SIZE_MB=5000

# Максимальный размер распакованного архива (в МБ)
MAX_EXTRACT_SIZE_MB=10000

# ============= NOTIFICATIONS =============
# Количество уведомлений для группировки
NOTIFICATION_BATCH_SIZE=5

# Таймаут для отправки батча уведомлений (в секундах)
NOTIFICATION_BATCH_TIMEOUT=30
